# ---------------------------------------------------------------------------
# Connectly environment template — PLACEHOLDERS ONLY, never commit real values.
#
#   cp server/.env.example server/.env   &&  fill in your values
#   cp client/.env.example client/.env   &&  fill in your values
#
# This root file is a single-page reference; the app reads server/.env and
# client/.env. See README.md §6 for the full table.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- server ----
NODE_ENV=development
PORT=4000

# Database: `mongo` for Atlas / local mongod, `memory` for a throwaway demo.
DB_DRIVER=mongo
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=connectly

# Secrets — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Allowed frontend origins (comma separated, no trailing slash)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173

# Cookies: use secure=true and sameSite=none in production (HTTPS required)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
TRUST_PROXY=0

# Limits
MESSAGE_MAX_LENGTH=4000
AVATAR_MAX_BYTES=2097152
SEARCH_PAGE_SIZE=10
MESSAGE_PAGE_SIZE=30
# UPLOAD_DIR=/var/connectly/uploads

# Optional S3-compatible storage so avatars survive Render restarts
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# First administrator: the email of an ALREADY REGISTERED account. The API
# promotes that account on boot (never creates one, never sets a password) and
# only while no active administrator exists. Server-side only — never send this
# to the client and never reuse it as a VITE_* variable.
# ADMIN_EMAIL=you@example.com

# Legacy bootstrap variables (optional, only if you are not using ADMIN_EMAIL)
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=

# Branding
BRAND_NAME=Connectly
BRAND_TAGLINE=Private conversations, anywhere in India.

# Password reset email (optional; without it reset links stay local to dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Connectly <no-reply@example.com>

# Demo data on boot (development only, never production)
SEED_DEMO=false

# Web Push (optional) — see server/.env.example for VAPID keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com

# ---------------------------------------------------------------- client ----
# Dev proxy target for the Vite dev server:
VITE_API_ORIGIN=http://localhost:4000
# Production API origin baked into the bundle (leave empty for same-origin):
VITE_API_URL=
VITE_SOCKET_URL=
