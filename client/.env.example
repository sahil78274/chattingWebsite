# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Where the Vite dev server proxies API/socket traffic (defaults to localhost:4000)
VITE_API_ORIGIN=http://localhost:4000

# ---------------------------------------------------------------------------
# Production (Vercel)
# ---------------------------------------------------------------------------
# Absolute URL of the deployed API, e.g. https://connectly-api.onrender.com
# Leave BOTH empty to use same-origin requests (useful when the frontend is
# served by the same host as the API, or via a reverse proxy).
VITE_API_URL=
# WebSocket endpoint. Defaults to VITE_API_URL when empty.
VITE_SOCKET_URL=

# Web Push public key for background notifications (optional, requires HTTPS + VAPID)
# VITE_VAPID_PUBLIC_KEY=
