{
  "name": "connectly-server",
  "version": "1.0.0",
  "private": true,
  "description": "Connectly chat backend - Express + Socket.IO + MongoDB",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js",
    "test:mongo": "NODE_ENV=test DB_DRIVER=mongo node --test --test-concurrency=1 tests/*.test.js",
    "seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0"
  }
}
