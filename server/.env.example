# ---------------------------------------------------------------------------
# Connectly environment template — PLACEHOLDERS ONLY, never commit real values.
#
# Copy to server/.env and fill in real values.
# Client-side variables live in client/.env.example. See README.md §6.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- server ----
NODE_ENV=development
PORT=4000

# Database. With DB_DRIVER unset the driver is inferred: `mongo` when a URI is
# present, otherwise the in-memory demo store (data is lost on restart).
# DB_DRIVER=mongo
MONGODB_URI=
MONGODB_DB_NAME=connectly

# Secrets — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Allowed frontend origins (comma separated, no trailing slash)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173

# Cookies: use secure=true and sameSite=none in production (HTTPS required)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
TRUST_PROXY=0

# Limits
MESSAGE_MAX_LENGTH=4000
AVATAR_MAX_BYTES=2097152
SEARCH_PAGE_SIZE=10
MESSAGE_PAGE_SIZE=30
# UPLOAD_DIR=/var/connectly/uploads

# Branding
BRAND_NAME=Connectly
BRAND_TAGLINE=Private conversations, anywhere in India.

# Password reset email (optional; without it reset links stay local to dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Connectly <no-reply@example.com>

# Demo data on boot (development only, never production)
SEED_DEMO=false

# Web Push for background notifications (optional, requires HTTPS)
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com
