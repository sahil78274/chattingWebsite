# ---------------------------------------------------------------------------
# Connectly environment template — PLACEHOLDERS ONLY, never commit real values.
#
# Copy to server/.env and fill in real values.
# Client-side variables live in client/.env.example. See README.md §6.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- server ----
NODE_ENV=development
PORT=4000

# Database. With DB_DRIVER unset the driver is inferred: `mongo` when a URI is
# present, otherwise the in-memory demo store (data is lost on restart).
# Production refuses the memory store unless ALLOW_MEMORY_STORE=true.
# DB_DRIVER=mongo
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=connectly
# ALLOW_MEMORY_STORE=false

# Secrets — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Allowed frontend origins (comma separated, no trailing slash)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173

# Cookies: use secure=true and sameSite=none in production (HTTPS required)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
TRUST_PROXY=0

# Limits
MESSAGE_MAX_LENGTH=4000
AVATAR_MAX_BYTES=2097152
SEARCH_PAGE_SIZE=10
MESSAGE_PAGE_SIZE=30
# Local disk is a development fallback. On Render this directory is wiped on
# every deploy — use S3 (below) or GridFS (automatic when Mongo is connected).
# UPLOAD_DIR=/var/connectly/uploads

# Optional S3-compatible object storage for avatars (Cloudflare R2, AWS S3, MinIO).
# When S3_BUCKET + keys are set, uploads go here so they survive Render restarts.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# First administrator. Register the account normally through /register first, then
# set its email here and restart the API. The account is promoted to role "admin"
# on boot; it is never created automatically and its password is never changed.
# The promotion only runs while the deployment has no active administrator, so it
# is idempotent and cannot silently re-promote a demoted account.
# ADMIN_EMAIL=you@example.com

# Legacy bootstrap variables, still supported (ADMIN_EMAIL takes precedence).
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=

# Branding
BRAND_NAME=Connectly
BRAND_TAGLINE=Private conversations, anywhere in India.

# Password reset email (optional; without it reset links stay local to dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Connectly <no-reply@example.com>

# Demo data on boot (development only, never production)
SEED_DEMO=false
